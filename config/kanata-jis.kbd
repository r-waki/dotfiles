;; Compact Japanese JIS layout without the numpad or navigation cluster.
;; The key names identify Kanata inputs; spacing follows the physical rows.
;; On Windows, the top-left JIS key is exposed as grv.
(defsrc
	esc   f1  f2  f3  f4  f5  f6  f7  f8  f9   f10  f11  f12
	grv   1   2   3   4   5   6   7   8   9    0    -    =    ¥     bspc
	tab   q   w   e   r   t   y   u   i   o    p    lbrc rbrc ret
	caps  a   s   d   f   g   h   j   k   l    scln apo  bksl
	lsft      z   x   c   v   b   n   m   comm .    /    ro  rsft
	lctl lmet lalt muhenkan       spc       henkan kana ralt rmet menu rctl
)

(defvar
  tap-time 200
  hold-time 200
  hold-time-slow 300
)

;; 複数の tap-hold キーを続けて押したとき、後から押したキーの判定時間もすぐに開始する
(defcfg
	concurrent-tap-hold yes
)

;; レイヤー切り替え定義
(defalias
	;; ホームポジション: タップで文字、ホールドでcmd1レイヤー
	s_cmd1 (tap-hold $tap-time $hold-time s (layer-while-held cmd1))
	l_cmd1 (tap-hold $tap-time $hold-time l (layer-while-held cmd1))
	d_cmd2 (tap-hold $tap-time $hold-time d (layer-while-held cmd2))
	k_cmd2 (tap-hold $tap-time $hold-time k (layer-while-held cmd2))
	a_num (tap-hold $tap-time $hold-time a (layer-while-held num))
	scln_num (tap-hold $tap-time $hold-time scln (layer-while-held num))
  f_symbols (tap-hold $tap-time $hold-time f (layer-while-held symbols))
  j_symbols (tap-hold $tap-time $hold-time j (layer-while-held symbols))
	n_alt (tap-hold $tap-time $hold-time n (multi lalt (layer-while-held win-switch)))
	v_alt (tap-hold $tap-time $hold-time v (multi lalt (layer-while-held win-switch)))
)

;; 同時押しでレイヤーを切り替え
(defchordsv2
	(s d) (layer-while-held cmd3) 50 all-released (cmd1 cmd2 cmd3 win-switch)
	(k l) (layer-while-held cmd3) 50 all-released (cmd1 cmd2 cmd3 win-switch)
)


(deflayer base
	_  _  _  _  _  _  _  _  _  _  _  _  _
	_  _  _  _  _  _  _  _  _  _  _  _  _  _  _
	_  _  _  _  _  _  _  _  _  _  _  _  _  _
	_  @a_num  @s_cmd1  @d_cmd2  @f_symbols  _  _  @j_symbols  @k_cmd2  @l_cmd1  @scln_num  _  _
	_  _  _  _  @v_alt  _  @n_alt  _  _  _  _  _  _
	_  _  _  _  _  _  _  _  _  _  _
)


