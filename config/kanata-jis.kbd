;; Standard JIS Keyboard config keeping normal keys via `_` (transparent)
;; while adding home-row layer toggles & navigation/symbol/num layers.

(defcfg
  process-unmapped-keys yes
)

(defsrc
  esc   f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
  grv   1     2     3     4     5     6     7     8     9     0     -     =     bspc
  tab   q     w     e     r     t     y     u     i     o     p     [     ]     ret
  caps  a     s     d     f     g     h     j     k     l     ;     '
  lsft  z     x     c     v     b     n     m     ,     .     /     ro    rsft
  lctl  lmet  lalt  muhenkan spc henkan kana  ralt  rmet  rctl
)

(defvar
  tap-time 200
  hold-time 200
  hold-time-slow 300
)

(defalias
  meh    (multi ctl alt sft)
  tmeh   (tap-hold $tap-time $hold-time spc @meh)

  ;; レイヤー切り替え定義
  l_cmd  (layer-toggle cmd)
  l_sys1 (layer-toggle sys1)
  l_sys2_layer (layer-toggle sys2)
  l_num  (layer-toggle num)
  ;; ホームポジション（タップで通常文字、長押しでレイヤー）
  f_cmd  (tap-hold $tap-time $hold-time f @l_cmd)
  j_cmd  (tap-hold $tap-time $hold-time j @l_cmd)
  d_sys1 (tap-hold $tap-time $hold-time d @l_sys1)
  k_sys1 (tap-hold $tap-time $hold-time-slow k @l_sys1)
  s_sys2 (tap-hold $tap-time $hold-time s @l_sys2_layer)
  l_sys2 (tap-hold $tap-time $hold-time-slow l @l_sys2_layer)
  a_num  (tap-hold $tap-time $hold-time-slow a @l_num)
  sc_num (tap-hold $tap-time $hold-time-slow ; @l_num)

  ;; cmdレイヤー用
  s_del  (tap-hold $tap-time $hold-time del home)
  cs_mod (multi ctl sft)
  d_pgdn_cs (tap-hold $tap-time $hold-time pgdn @cs_mod)
)

;; ベースレイヤー：JISキーを活かしつつホームポジション長押しで各レイヤーへ
(deflayer base
  _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  lctl  @a_num @s_sys2 @d_sys1 @f_cmd _   _     @j_cmd @k_sys1 @l_sys2 @sc_num _
  _     _     _     _     _     _     _     _     _     _     _     _     _
  caps  _     _     muhenkan @tmeh henkan _     _     _     _
)

;; cmdレイヤー：カーソル移動・編集・タブ操作（他のキーはそのまま透過 `_`）
(deflayer cmd
  _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     tab   esc   C-S-tab C-tab _     _     pgup  _    bspc  C-v   _     _     _
  _     _     @s_del @d_pgdn_cs _     _     left     down  up  right ret   _
  _     _     _     _     _     _     _  end   home  _     _     _     _
  _     _     _     _     _     _     _     _     _     _
)

;; sys1レイヤー：記号入力補助
(deflayer sys1
  _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     S-1   S-2   S-3   S-4   S-5   S-6   S-7   S-8   S-9   S-0   _     _     _
  _     grv   -     =     \     S-\   C-left C-down C-up C-right ]     _
  _     _     _     _     _     _     _     _     S--   S-=   [     ]     _
  _     _     _     _     _     _     _     _     _     _
)

;; sys2レイヤー：クリップボードやよく使う操作
(deflayer sys2
  _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     C-v   _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     C-c   _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _
)

;; numレイヤー：右手側にテンキー配置
(deflayer num
  _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     7     8     9     0     _     _     _
  _     _     _     _     _     _     _     4     5     6     .     _
  _     _     _     _     _     _     _     1     2     3     _     _     _
  _     _     _     _     _     _     _     _     _     _
)